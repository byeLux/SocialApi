; Copiare in config/.env e impostare le credenziali private.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="social"
DB_USER="replace_locally"
DB_PASSWORD="replace_locally"
APP_ENV="local"
APP_DEBUG="false"
; Chiave generata manualmente: almeno 32 byte casuali, ad esempio 64 caratteri esadecimali.
; Il nome JWT_KEY non indica un token JWT standard.
JWT_KEY=""
